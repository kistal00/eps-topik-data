  "grammar": [
    {
      "point": "(으)로 (방향)",
      "explanation": "Attaches to place or directional nouns to indicate the destination or direction of movement.",
      "explanationNp": "कुन दिशातर्फ जाने भन्ने गन्तव्य वा दिशा खुलाउँदा नामको पछाडि जोडिन्छ। बाच्छिम भए '-으로' (उदा: 밑으로 = तलतिर), बाच्छिम नभए वा 'ㄹ' भए '-로' (उदा: 오른쪽으로 = दायाँतर्फ, 앞으로 = अगाडितिर)।",
      "examples": [
        "사거리에서 오른쪽으로 가세요. — चौबाटोबाट दायाँतर्फ जानुहोस्।"
      ]
    },
    {
      "point": "-(으)세요",
      "explanation": "Used to politely order, command, or request the listener to perform an action.",
      "explanationNp": "सुन्ने व्यक्तिलाई कुनै कार्य गर्नको लागि आदरपूर्वक आग्रह वा निर्देशन दिँदा क्रियाको धातुमा जोडिन्छ। बाच्छिम भए '-으세요' (उदा: 앉으세요 = बस्नुहोस्), बाच्छिम नभए वा 'ㄹ' भए '-세요' (उदा: 가세요 = जानुहोस्)।",
