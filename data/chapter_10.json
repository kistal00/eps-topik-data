  "grammar": [
    {
      "point": "-네요",
      "explanation": "Used to express exclamation, admiration, or surprise upon discovering or experiencing something new.",
      "explanationNp": "आफूले भर्खरै देखेको, अनुभव गरेको वा थाहा पाएको कुरामा आश्चर्य वा प्रशंसा व्यक्त गर्दा प्रयोग गरिन्छ। धातु + 네요 (बाच्छिम भए पनि नभए पनि '네요' नै जोडिन्छ। उदा: 크네요 = ठूलो रहेछ!, 덥네요 = गर्मी रहेछ नि!)।",
      "examples": [
        "수박이 정말 크고 싱싱하네요! — खर्बुजा साँच्चै ठूलो र ताजा रहेछ नि!",
        "투안 씨는 한국말을 참 잘하네요. — तुआन जीले त कोरियन भाषा धेरै राम्रो बोल्नुहुँदो रहेछ।"
      ]
    },
    {
      "point": "-아/어 주세요",
      "explanation": "Attaches to verbs to politely request someone to perform an action for the speaker.",
      "explanationNp": "क्रियाको धातुसँग जोडिएर अरू व्यक्तिलाई कुनै काम गरिदिनको लागि विनम्र अनुरोध गर्दा प्रयोग गरिन्छ। धातुको स्वर 'ㅏ, ㅗ' भए '-아 주세요' (उदा: 깎다 → 깎아 주세요 = घटाइदिनुहोस्), अन्य स्वर भए '-어 주세요' (उदा: 포장하다 → 포장해 주세요 = प्याक गरिदिनुहोस्, 바꾸다 → 바꿔 주세요 = साटिदिनुहोस्)।",
      "examples": [
        "봉투에 넣어 주세요. — झोलामा (प्लास्टिक ब्यागमा) हालिदिनुहोस्।",
        "바지가 작아요. 다른 것으로 교환해 주세요. — प्यान्ट सानो भयो। अर्कोसँग साटिदिनुहोस्।"
      ]
    }
