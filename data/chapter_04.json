  "grammar": [
    {
      "point": "-아요 / 어요",
      "explanation": "Attaches to the stem of a verb or adjective to express an action or state in informal, polite present tense.",
      "explanationNp": "क्रिया वा विशेषणको धातु (Stem) सँग जोडिएर वर्तमान कालको सामान्य आदरार्थी रूप बनाउँछ। धातुको अन्तिम स्वर 'ㅏ, ㅗ' भए '-아요' (उदा: 가다 → 가요, 보다 → 봐요), अन्य स्वर भए '-어요' (उदा: 먹다 → 먹어요, 마시다 → 마셔요), '하다' भए '해요' (उदा: 일하다 → 일해요) जोडिन्छ।",
      "examples": [
        "지금 뭐 해요? / 텔레비전을 봐요. — क: अहिले के गर्दै हुनुहुन्छ? / ख: टिभी हेर्दैछु।",
        "투안 씨는 회사에서 일해요. — तुआन जी कम्पनीमा काम गर्नुहुन्छ।"
      ]
    },
    {
      "point": "을 / 를",
      "explanation": "Attaches to a noun that is the object of a transitive verb.",
      "explanationNp": "सकर्मक क्रियाको कर्म (Object) को पछाडि जोडिएर क्रियाको असर पर्ने वस्तु जनाउँछ। बाच्छिम भए '을' (उदा: 밥을 먹어요 = भात खान्छु, 책을 읽어요 = किताब पढ्छु), बाच्छिम नभए '를' (उदा: 사과를 먹어요 = स्याउ खान्छु, 커피를 마셔요 = कफी पिउँछु) जोडिन्छ।",
      "examples": [
        "아침에 빵을 먹어요. — बिहान पाउरोटी खान्छु।",
        "친구하고 영화를 봐요. — साथीसँग फिल्म हेर्छु।"
      ]
    }
  ],
