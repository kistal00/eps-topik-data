  "grammar": [
    {
      "point": "에",
      "explanation": "Attaches to a time noun to indicate when an action takes place.",
      "explanationNp": "समय जनाउने नामको पछाडि जोडिएर कुनै कार्य कुन समय वा बारमा हुन्छ भन्ने दर्शाउँछ। समय + 에 (उदा: 월요일에 = सोमबारमा, 몇 시에 = कति बजे)। ध्यान दिनुहोस्: '어제', '오늘', '내일', '지금' को पछाडि '에' जोडिँदैन।",
      "examples": [
        "금요일에 영화를 봐요. — शुक्रबार चलचित्र हेर्छु।",
        "가: 몇 시에 자요? / 나: 11시에 자요. — क: कति बजे सुत्नुहुन्छ? / ख: ११ बजे सुत्छु।"
      ]
    },
    {
      "point": "-았 / 었-",
      "explanation": "Attaches to the stem of a verb or adjective to express an action or state that occurred in the past.",
      "explanationNp": "क्रिया वा विशेषणको धातुसँग जोडिएर बितेको समयमा सम्पन्न भएको कार्य व्यक्त गर्दछ। धातुको अन्तिम स्वर 'ㅏ, ㅗ' भए '-았어요' (उदा: 가다 → 갔어요 = गएँ, 오다 → 왔어요 = आएँ), अन्य स्वर भए '-었어요' (उदा: 먹다 → 먹었어요 = खाएँ, 마시다 → 마셨어요 = पिएँ), '하다' भए '했어요' (उदा: 공부하다 → 공부했어요 = पढेँ) जोडिन्छ।",
      "examples": [
        "어제 친구를 만났어요. — हिजो साथीलाई भेटेँ।",
        "주말에 방을 청소했어요. — सप्ताहन्तमा कोठा सफा गरेँ।"
      ]
    }
  ],
