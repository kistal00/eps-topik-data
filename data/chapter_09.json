  "grammar": [
    {
      "point": "주세요",
      "explanation": "Used after a noun to politely request or order the specified item.",
      "explanationNp": "संज्ञाको पछाडि जोडिएर पसल वा रेस्टुरेन्टमा सामान माग्दा वा खाना अर्डर गर्दा प्रयोग गरिन्छ। वस्तु + 주세요 (उदा: 물 주세요 = पानी दिनुहोस्, 비빔밥 주세요 = विबिमबाप दिनुहोस्)।",
      "examples": [
        "사장님, 김치찌개 하나 주세요. — साहुजी, एउटा खिम्ची झोल दिनुहोस्।",
        "시원한 물 좀 주세요. — कृपया चिसो पानी दिनुहोस्।"
      ]
    },
    {
      "point": "하고",
      "explanation": "Used in spoken Korean to connect two nouns (and) or indicate with whom an action is performed.",
      "explanationNp": "दुई नामहरूलाई जोड्दा 'र' वा कसैसँग मिलेर काम गर्दा 'सँग' भन्ने अर्थमा प्रयोग गरिन्छ। नाम + 하고 (बाच्छिम भए पनि नभए पनि '하고' नै जोडिन्छ)।",
      "examples": [
        "식당에서 밥하고 국을 먹었어요. — रेस्टुरेन्टमा भात र सुप खाएँ।",
        "친구하고 같이 쇼핑했어요. — साथीसँग मिलेर किनमेल गरेँ।"
      ]
    }
  ],
