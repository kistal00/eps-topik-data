  "grammar": [
    {
      "point": "이/가 있어요, 없어요",
      "explanation": "Indicates the existence or possession of a person or object.",
      "explanationNp": "कर्ता वा वस्तुको उपस्थिति (छ) वा अनुपस्थिति (छैन) व्यक्त गर्दा प्रयोग गरिन्छ। बाच्छिम भए '이 있어요/없어요' (उदा: 옷장이 있어요), बाच्छिम नभए '가 있어요/없어요' (उदा: 침대가 있어요) जोडिन्छ।",
      "examples": [
        "방에 침대가 있어요. — कोठामा खाट छ।",
        "거실에 텔레비전이 없어요. — बैठक कोठामा टेलिभिजन छैन।"
      ]
    },
    {
      "point": "에 있어요 / 없어요",
      "explanation": "Attaches to place nouns to indicate the location where something exists or does not exist.",
      "explanationNp": "स्थान जनाउने नामको पछाडि '에' (मा) जोडेर व्यक्ति वा वस्तु कुन ठाउँमा छ वा छैन भन्ने दर्शाउँछ। स्थान + 에 있어요 (उदा: 회사에 있어요 = कम्पनीमा हुनुहुन्छ/छ)",
      "examples": [
        "투안 씨는 지금 회사에 있어요. — तुआन जी अहिले कम्पनीमा हुनुहुन्छ।",
        "가: 약국이 어디에 있어요? / 나: 저기에 있어요. — क: औषधि पसल कहाँ छ? / ख: त्यहाँ पर छ।"
      ]
    }
  ],
