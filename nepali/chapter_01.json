  "grammar": [
    {
      "id": "ch01_g_001",
      "point": "입니다, 입니까?",
      "explanationNepali": "입니다 संज्ञासँग जोडिएर औपचारिक अवस्थामा ‘हो/हुनुहुन्छ’ भन्ने अर्थमा वाक्यको अन्त्यमा प्रयोग हुन्छ। 입니까? यसको प्रश्नवाचक रूप हो र कसैको परिचय वा विशेषताबारे सोध्दा प्रयोग गरिन्छ।",
      "examples": [
        {
          "korean": "왕민입니다.",
          "nepali": "म वाङ मिन हुँ।"
        },
        {
          "korean": "가: 어느 나라 사람입니까? 나: (저는) 라오스 사람입니다.",
          "nepali": "क: तपाईं कुन देशको व्यक्ति हुनुहुन्छ? ख: म लाओसको व्यक्ति हुँ।"
        },
        {
          "korean": "(저는) 유수프입니다.",
          "nepali": "म युसुफ हुँ।"
        }
      ]
    },
    {
      "id": "ch01_g_002",
      "point": "은/는",
      "explanationNepali": "은/는 नामसँग जोडिएर वाक्यको विषय वा चर्चाको मुख्य कुरा जनाउँछ। अन्तिम व्यञ्जन (받침) भएको नामपछि 은 र अन्तिम व्यञ्जन नभएको नामपछि 는 प्रयोग हुन्छ।",
      "examples": [
        {
          "korean": "받침 ○: 푸캄은 / 받침 ×: 자야는",
          "nepali": "अन्तिम व्यञ्जन भए: 푸캄은 / अन्तिम व्यञ्जन नभए: 자야는"
        },
        {
          "korean": "투안은 목수입니다.",
          "nepali": "तुआन सिकर्मी हुन्।"
        },
        {
          "korean": "진수 씨는 회사원입니다.",
          "nepali": "जिन्सु कम्पनीका कर्मचारी हुन्।"
        },
        {
          "korean": "자하라 씨는 파키스탄 사람입니다.",
          "nepali": "जहार पाकिस्तानकी हुन्।"
        }
      ]
    }
  ],
