  "expressions": [
    {
      "id": "ch01_e_001",
      "korean": "잘 부탁드립니다.",
      "meaningNepali": "पहिलोपटक भेट्दा प्रयोग हुने विनम्र अभिव्यक्ति। प्रसङ्गअनुसार ‘तपाईंसँग राम्रो सम्बन्ध वा सहकार्यको आशा गर्दछु’ अथवा ‘आगामी दिनमा तपाईंको सहयोगको अपेक्षा गर्दछु’ भन्न सकिन्छ।",
      "exampleKorean": "가: 안녕하세요? 처음 뵙겠습니다. 나: 안녕하세요? 잘 부탁드립니다.",
      "exampleNepali": "क: नमस्कार। तपाईंलाई पहिलोपटक भेट्दै छु। ख: नमस्कार। तपाईंलाई भेटेर खुसी लाग्यो; आगामी दिनमा राम्रो सहकार्यको आशा गर्छु।"
    }
  ],
  "cultureNotes": [
    {
      "id": "ch01_c_001",
      "title": "कोरियामा अभिवादन गर्ने शिष्टाचार",
      "paragraphsNepali": [
        "कोरियामा कसलाई अभिवादन गरिँदैछ भन्ने आधारमा अभिवादन गर्ने तरिका फरक हुन्छ। आफूभन्दा उमेरले ठूलो वा पदमा उच्च व्यक्तिलाई 안녕하세요? वा 안녕하십니까? भनेर टाउको झुकाएर वा कम्मर निहुराएर अभिवादन गरिन्छ। यसरी झुक्नु अर्को व्यक्तिप्रतिको सम्मानको संकेत हो।",
        "आफूभन्दा कान्छो वा नजिकको व्यक्तिलाई 안녕? भनेर हल्का हात उठाई वा हल्लाई आत्मीयता देखाउन सकिन्छ। यी अभिवादनहरू बिहान, दिउँसो वा बेलुका जुनसुकै समयमा प्रयोग गर्न सकिन्छ।",
        "औपचारिक अवस्थामा प्रायः हात मिलाएर अभिवादन गरिन्छ। आफूभन्दा निकै जेठो वा उच्च पदको व्यक्तिसँग हात मिलाउँदा दाहिने हात वा पाखुरालाई देब्रे हातले सहारा दिनु शिष्टाचार मानिन्छ।"
      ]
    }
  ],
